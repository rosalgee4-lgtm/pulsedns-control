# 复制为 .env 后填写；.env 含密钥，权限设为 600，不要提交到 Git。

# 外置 MySQL 8 / MariaDB 10.6+ 连接串（库需预先创建，字符集 utf8mb4）。
PULSEDNS_DATABASE_URL=mysql://pulsedns:请替换为数据库密码@127.0.0.1:3306/pulsedns

# 面板对外的 HTTPS 地址（宝塔反向代理的域名），不含随机路径。
PULSEDNS_PUBLIC_URL=https://panel.example.com

# 随机入口路径：/ 加 32 位小写十六进制。生成：printf '/%s\n' "$(openssl rand -hex 16)"
PULSEDNS_BASE_PATH=

# 加密密钥（加密阿里云 AccessKey、开机配置与 Nyanpass Token）。生成：openssl rand -hex 32
# 一旦使用就不能更换或丢失，否则已保存的密钥无法解密。
PULSEDNS_TASK_ENCRYPTION_KEY=

# 首次启动时创建管理员（数据库只保存密码哈希）。创建成功后可以删除这两行。
PULSEDNS_INITIAL_ADMIN_USER=admin
PULSEDNS_INITIAL_ADMIN_PASSWORD=

# 面板在本机监听的端口（只绑定 127.0.0.1）。
PULSEDNS_PANEL_PORT=3100
